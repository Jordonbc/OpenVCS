{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@scripts/*": ["./src/scripts/*"],
      "@modals/*": ["./src/modals/*"]
    },
    "types": ["vite/client", "vitest/globals"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
